# ==============================================================================
# EduSync AI - Environment Configuration Template
# Copy this file to .env and fill in your actual production/staging values.
# DO NOT COMMIT REAL CREDENTIALS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# Pooled connection URL (Recommended for Next.js runtime & serverless)
DATABASE_URL="postgresql://username:password@ep-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection URL (Used for Prisma schema migrations)
DIRECT_URL="postgresql://username:password@ep-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# AI Quiz Generation (Google AI Studio Gemini API Key)
GEMINI_API_KEY="your-gemini-api-key-here"

# Capacitor Mobile Backend URL (Point to your deployed HTTPS domain for mobile distribution)
# Example: https://edusync-ai.vercel.app
CAPACITOR_SERVER_URL="http://localhost:3000"
